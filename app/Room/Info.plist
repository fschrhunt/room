<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Room.app. scripts/app.sh fills in __VERSION__. CFBundleSymbolName is the sidebar symbol Finder
     shows on the row its Finder Sync extension watches; CFBundleIconName is the app icon. -->
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>Room</string>
  <key>CFBundleIdentifier</key><string>sh.room.app</string>
  <key>CFBundleName</key><string>Room</string>
  <key>CFBundleDisplayName</key><string>Room</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>__VERSION__</string>
  <key>CFBundleVersion</key><string>__VERSION__</string>
  <key>CFBundleIconName</key><string>room</string>
  <key>CFBundleIconFile</key><string>room</string>
  <key>CFBundleIcons</key>
  <dict>
    <key>CFBundlePrimaryIcon</key>
    <dict>
      <key>CFBundleIconName</key><string>room</string>
      <key>CFBundleSymbolName</key><string>room.sidebar</string>
    </dict>
  </dict>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
