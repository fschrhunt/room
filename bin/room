#!/bin/sh
# room — mount an SMB share at login on macOS, the native way.
#
# room sets up a share, writes the `room` launchd agent, and keeps the share
# mounted: the agent waits for the host to answer, then mounts it through NetFS,
# Finder's framework, with no UI, so the password comes from the login keychain, no
# dialog appears, and the volume behaves like any other. Each pass also checks that the mount still
# answers and replaces a dead one, and the share is mounted soft, so a server that
# goes away fails calls instead of hanging them. No kernel extension, no FUSE, no
# Apple Developer account.
#
# room manages one share. Its config, agent and log are all just `room`:
#   ~/.config/room/config
#   ~/Library/LaunchAgents/room.plist   (label: room)
#   ~/Library/Logs/room.log
set -eu

VERSION="0.1.1"

# Resolved through variables so tests can substitute stubs.
MOUNT=${ROOM_MOUNT:-/sbin/mount}
NC=${ROOM_NC:-/usr/bin/nc}
OSASCRIPT=${ROOM_OSASCRIPT:-/usr/bin/osascript}
LAUNCHCTL=${ROOM_LAUNCHCTL:-/bin/launchctl}
DISKUTIL=${ROOM_DISKUTIL:-/usr/sbin/diskutil}
SECURITY=${ROOM_SECURITY:-/usr/bin/security}
PROBE=${ROOM_PROBE:-probe_statfs}

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/room/config"
LOG_FILE="$HOME/Library/Logs/room.log"
PLIST_FILE="$HOME/Library/LaunchAgents/room.plist"
LOCK_FILE="$HOME/Library/Logs/.room.lock"
NSMB_CONF=${ROOM_NSMB_CONF:-$HOME/Library/Preferences/nsmb.conf}
AGENT_LABEL="room"
REACH_TRIES=${ROOM_REACH_TRIES:-12}
REACH_WAIT=${ROOM_REACH_WAIT:-8}
MOUNT_TRIES=${ROOM_MOUNT_TRIES:-5}
MOUNT_WAIT=${ROOM_MOUNT_WAIT:-5}
HEALTH_WAIT=${ROOM_HEALTH_WAIT:-5}
STALE_WAIT=${ROOM_STALE_WAIT:-20}
UNMOUNT_WAIT=${ROOM_UNMOUNT_WAIT:-60}
LOCK_STALE_MIN=10

SELF=$0
case $SELF in
/*) ;;
*) SELF=$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0") ;;
esac

say() { printf '%s\n' "$*"; }
warn() { printf 'room: %s\n' "$*" >&2; }
die() {
  printf 'room: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
room — mount an SMB share at login on macOS, the native way.

usage:
  room add <smb://user@host/share>   set up the share, load the agent, mount now
  room status                        show mount and agent state
  room logs                          show the log
  room mount                         mount now
  room unmount                       unmount now
  room remove                        unload the agent and forget the share
  room doctor                        check config, agent, server and keychain
  room uninstall                     remove room entirely
  room version

Run `room` with no arguments to see the current state.

The share's password is read from the login keychain. Run `room add` while logged
in so Finder can ask for it once; after that the launchd agent keeps it mounted.
EOF
}

config_get() { awk -F= -v k="$2" '$1==k { sub(/^[^=]*=/, ""); print; exit }' "$1"; }

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE"; }

parse_url() {
  case $1 in
  smb://*) _rest=${1#smb://} ;;
  //*) _rest=${1#//} ;;
  *) die "not an smb:// URL: $1" ;;
  esac
  case $_rest in
  */*)
    _auth=${_rest%%/*}
    _share=${_rest#*/}
    ;;
  *) die "URL has no share: $1" ;;
  esac
  _share=${_share%%/*}
  [ -n "$_share" ] || die "URL has no share: $1"
  case $_auth in
  *@*)
    _cred=${_auth%@*}
    case $_cred in *:*) die "refusing a password in the URL; let the keychain hold it" ;; esac
    USER=${_cred##*;}
    SERVER=${_auth##*@}
    ;;
  *)
    USER=$(id -un)
    SERVER=$_auth
    ;;
  esac
  [ -n "$SERVER" ] || die "URL has no server: $1"
  SHARE=$_share
}

load_config() {
  [ -f "$CONFIG_FILE" ] || die "room is not set up; run: room add <smb://user@host/share>"
  SERVER=$(config_get "$CONFIG_FILE" server)
  SHARE=$(config_get "$CONFIG_FILE" share)
  USER=$(config_get "$CONFIG_FILE" user)
  VOLUME=$(config_get "$CONFIG_FILE" volume)
  [ -n "$SERVER" ] && [ -n "$SHARE" ] && [ -n "$VOLUME" ] || die "corrupt config: $CONFIG_FILE"
  URL="smb://${USER}@${SERVER}/${SHARE}"
}

# Print where the share is mounted, wherever Finder put it: /Volumes/Share, or
# /Volumes/Share-1 when a leftover mount point holds the usual name.
share_mountpoint() {
  "$MOUNT" | awk -v src="@${SERVER}/${SHARE} on " '
    index($0, src) && / \(smbfs/ { sub(/^.* on /, ""); sub(/ \(smbfs.*$/, ""); print; exit }'
}

# Run a command for at most $1 seconds. Fails when it fails or is still running,
# and never waits on a call stuck in a dead mount.
within() {
  _limit=$1
  shift
  "$@" >/dev/null 2>&1 &
  _pid=$!
  _t=0
  while kill -0 "$_pid" 2>/dev/null; do
    if [ "$_t" -ge "$_limit" ]; then
      kill "$_pid" 2>/dev/null || true
      return 1
    fi
    sleep 1
    _t=$((_t + 1))
  done
  wait "$_pid"
}

# A mount counts only if it answers: a listed mount whose server is gone hangs.
# Ask the server for the volume's size (statfs) rather than list it: macOS's Network
# Volumes privacy rule blocks a background agent from listing the share, which made a
# healthy mount look dead; statfs still reaches the server, so a dead one still fails.
probe_statfs() { /usr/bin/stat -f %z "$1"; }

responsive() { within "$HEALTH_WAIT" "$PROBE" "$1"; }

# Expose the share at ~/room. Creates the link, or repoints room's own link when
# the share moved to another mount point; never touches anything else there.
ensure_link() {
  if [ ! -e "$HOME/room" ] && [ ! -L "$HOME/room" ]; then
    ln -s "$1" "$HOME/room"
  elif [ -L "$HOME/room" ]; then
    _cur=$(readlink "$HOME/room")
    case $_cur in
    "$VOLUME" | "$VOLUME"-[0-9]*) [ "$_cur" = "$1" ] || ln -sfn "$1" "$HOME/room" ;;
    esac
  fi
}

# Mount this share soft, through the user's own nsmb.conf: a dead server then
# fails calls after about a minute instead of hanging them, and unmount, for up to
# ten. Scoped to [SERVER:SHARE]; takes effect on the next mount.
ensure_soft() {
  _sec="[${SERVER}:${SHARE}]"
  if [ -f "$NSMB_CONF" ] && awk -v s="$_sec" '
    $0 == s { f = 1; next } /^\[/ { f = 0 } f && $0 == "soft=yes" { ok = 1 } END { exit !ok }' "$NSMB_CONF"; then
    return 0
  fi
  mkdir -p "$(dirname "$NSMB_CONF")"
  if [ -f "$NSMB_CONF" ] && grep -qxF "$_sec" "$NSMB_CONF"; then
    awk -v s="$_sec" '{ print } $0 == s { print "soft=yes" }' "$NSMB_CONF" >"$NSMB_CONF.room" &&
      mv "$NSMB_CONF.room" "$NSMB_CONF"
  else
    if [ -s "$NSMB_CONF" ]; then echo >>"$NSMB_CONF"; fi
    printf '%s\nsoft=yes\n' "$_sec" >>"$NSMB_CONF"
  fi
}

# Drop the section ensure_soft wrote, if it still holds only that line.
remove_soft() {
  [ -f "$NSMB_CONF" ] || return 0
  awk -v s="[${SERVER}:${SHARE}]" '
    { line[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        if (line[i] == s && line[i + 1] == "soft=yes" && (i + 2 > NR || line[i + 2] ~ /^(\[|$)/)) { i++; continue }
        print line[i]
      }
    }' "$NSMB_CONF" >"$NSMB_CONF.room" && mv "$NSMB_CONF.room" "$NSMB_CONF"
  grep -q . "$NSMB_CONF" || rm -f "$NSMB_CONF"
}

# Unmount the share wherever it is; force a dead mount off.
# Mount the share through NetFS, the framework Finder mounts with, so the password still
# comes from the login keychain, but with no UI: a background pass never raises a dialog. A
# leftover mount point at $VOLUME that we own is mounted onto directly, so the share never
# lands at a "-1" name; otherwise NetFS creates $VOLUME under its parent.
netfs_mount() {
  if [ -d "$VOLUME" ] && chmod u+rwx "$VOLUME" 2>/dev/null; then
    set -- "$VOLUME" exact
  else
    set -- "$(dirname "$VOLUME")" inside
  fi
  "$OSASCRIPT" -l JavaScript - "$URL" "$1" "$2" <<'EOF'
ObjC.import('Foundation');
ObjC.import('NetFS');
function run(argv) {
  const open = $.NSMutableDictionary.alloc.init;
  open.setObjectForKey($('NoUI'), $('UIOption'));
  const mount = $.NSMutableDictionary.alloc.init;
  if (argv[2] === 'exact') mount.setObjectForKey($.NSNumber.numberWithBool(true), $('MountAtMountDir'));
  const rc = $.NetFSMountURLSync($.NSURL.URLWithString(argv[0]),
    $.NSURL.fileURLWithPath(argv[1]), null, null, open, mount, Ref());
  if (rc !== 0) throw new Error('NetFS error ' + rc);
}
EOF
}

unmount_share() {
  _mp=$(share_mountpoint)
  [ -n "$_mp" ] || return 0
  within "$UNMOUNT_WAIT" "$DISKUTIL" unmount "$_mp" ||
    within "$UNMOUNT_WAIT" "$DISKUTIL" unmount force "$_mp" || true
  [ -z "$(share_mountpoint)" ]
}

# Take the agent's lock. A pass killed mid-run leaves it behind, so an old one expires.
take_lock() {
  if [ -d "$LOCK_FILE" ] && [ -n "$(find "$LOCK_FILE" -maxdepth 0 -mmin +"$LOCK_STALE_MIN" 2>/dev/null)" ]; then
    rmdir "$LOCK_FILE" 2>/dev/null || true
  fi
  mkdir "$LOCK_FILE" 2>/dev/null
}

write_config() {
  mkdir -p "$(dirname "$CONFIG_FILE")"
  (
    umask 077
    {
      printf 'server=%s\n' "$SERVER"
      printf 'share=%s\n' "$SHARE"
      printf 'user=%s\n' "$USER"
      printf 'volume=%s\n' "$VOLUME"
    } >"$CONFIG_FILE"
  )
}

write_plist() {
  mkdir -p "$(dirname "$PLIST_FILE")"
  cat >"$PLIST_FILE" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${AGENT_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${SELF}</string>
    <string>agent</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>sh.room.app</string>
  </array>
</dict>
</plist>
EOF
}

bootstrap_agent() {
  "$LAUNCHCTL" bootstrap "gui/$(id -u)" "$PLIST_FILE" 2>/dev/null && return 0
  "$LAUNCHCTL" load "$PLIST_FILE" 2>/dev/null && return 0
  warn "could not load the agent; load it with: launchctl bootstrap gui/$(id -u) $PLIST_FILE"
  return 1
}

bootout_agent() {
  "$LAUNCHCTL" bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null && return 0
  "$LAUNCHCTL" unload "$PLIST_FILE" 2>/dev/null || true
}

cmd_add() {
  [ $# -eq 1 ] || die "usage: room add <smb://user@host/share>"
  parse_url "$1"
  VOLUME="/Volumes/$SHARE"
  mkdir -p "$(dirname "$CONFIG_FILE")" "$(dirname "$LOG_FILE")"
  write_config
  write_plist
  bootout_agent || true
  bootstrap_agent || true
  load_config
  say "registered $URL -> $VOLUME"
  say "agent: $PLIST_FILE"
  say "log:   $LOG_FILE"
  cmd_mount
}

cmd_mount() {
  load_config
  ensure_soft
  _mp=$(share_mountpoint)
  if [ -n "$_mp" ] && responsive "$_mp"; then
    ensure_link "$_mp"
    say "room is already mounted at $_mp"
    return 0
  fi
  [ -z "$_mp" ] || unmount_share || true
  _out=$("$OSASCRIPT" -e "mount volume \"$URL\"" 2>&1) || true
  _mp=$(share_mountpoint)
  if [ -n "$_mp" ]; then
    ensure_link "$_mp"
    say "mounted $_mp"
  else
    warn "could not mount: ${_out:-no error output}"
    warn "the agent will retry every minute; connect once in Finder if the password is missing"
    return 1
  fi
}

cmd_unmount() {
  load_config
  _mp=$(share_mountpoint)
  [ -n "$_mp" ] || return 0
  if unmount_share; then say "unmounted $_mp"; else warn "could not unmount $_mp"; fi
}

cmd_remove() {
  load_config
  bootout_agent || true
  cmd_unmount
  remove_soft
  rm -f "$PLIST_FILE" "$CONFIG_FILE" "$LOG_FILE"
  say "room removed"
}

cmd_status() {
  load_config
  _mp=$(share_mountpoint)
  if [ -z "$_mp" ]; then
    say "$URL -> $VOLUME (down)"
  elif responsive "$_mp"; then
    say "$URL -> $_mp (mounted)"
  else
    say "$URL -> $_mp (mounted, not responding)"
  fi
  "$LAUNCHCTL" print "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null | grep -E 'state = |last exit code = |runs = ' || say "agent not loaded"
  tail -n 1 "$LOG_FILE" 2>/dev/null || true
}

cmd_logs() {
  [ -f "$LOG_FILE" ] || die "no log yet"
  tail -n 40 "$LOG_FILE"
}

cmd_doctor() {
  load_config
  say "config:   $CONFIG_FILE"
  say "share:    $URL"
  say "volume:   $VOLUME"
  if [ -L "$HOME/room" ]; then
    say "path:     $HOME/room -> $(readlink "$HOME/room")"
  else
    warn "path:     $HOME/room missing"
  fi
  if "$LAUNCHCTL" print "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1; then
    say "agent:    loaded"
  else
    warn "agent:    not loaded"
  fi
  _mp=$(share_mountpoint)
  if [ -z "$_mp" ]; then
    warn "mount:    not mounted"
  elif responsive "$_mp"; then
    say "mount:    mounted at $_mp"
  else
    warn "mount:    $_mp is not responding; the agent replaces it on its next pass"
  fi
  if [ -f "$NSMB_CONF" ] && grep -qxF "[${SERVER}:${SHARE}]" "$NSMB_CONF"; then
    say "soft:     yes ($NSMB_CONF)"
  else
    warn "soft:     not set; the next mount sets it"
  fi
  if "$NC" -z -G 3 -w 3 "$SERVER" 445 >/dev/null 2>&1; then
    say "server:   ${SERVER}:445 reachable"
  else
    warn "server:   ${SERVER}:445 unreachable"
  fi
  if "$SECURITY" find-internet-password -s "$SERVER" >/dev/null 2>&1; then
    say "keychain: a saved credential exists for $SERVER"
  else
    warn "keychain: no saved credential for $SERVER; the first mount will ask Finder"
  fi
}

cmd_agent() {
  load_config
  mkdir -p "$(dirname "$LOG_FILE")"
  ensure_soft
  take_lock || exit 0
  trap 'rmdir "$LOCK_FILE" 2>/dev/null' EXIT HUP INT TERM
  _mp=$(share_mountpoint)
  if [ -n "$_mp" ] && responsive "$_mp"; then
    # A share Finder put under another name (Share-1) moves back to $VOLUME when nothing
    # holds it open; a busy one is followed instead, since unmounting it breaks open files.
    if [ "$_mp" = "$VOLUME" ] || ! within "$UNMOUNT_WAIT" "$DISKUTIL" unmount "$_mp" ||
      [ -n "$(share_mountpoint)" ]; then
      ensure_link "$(share_mountpoint)"
      exit 0
    fi
    log "unmounted ${_mp} to mount it at ${VOLUME}"
  elif [ -n "$_mp" ]; then
    # A slow answer is not a dead mount, and replacing a live one breaks open files.
    # Replace it only while the server is up and a longer second probe also fails.
    if ! "$NC" -z -G 3 -w 3 "$SERVER" 445 >/dev/null 2>&1; then
      log "${_mp} is not responding and ${SERVER}:445 is unreachable; leaving it"
      exit 0
    fi
    if within "$STALE_WAIT" "$PROBE" "$_mp"; then
      ensure_link "$_mp"
      exit 0
    fi
    log "${_mp} is not responding; unmounting it"
    if ! unmount_share; then
      log "could not unmount ${_mp}; retrying next pass"
      exit 1
    fi
  fi
  _i=0
  while [ "$_i" -lt "$REACH_TRIES" ]; do
    "$NC" -z -G 3 -w 3 "$SERVER" 445 >/dev/null 2>&1 && break
    _i=$((_i + 1))
    sleep "$REACH_WAIT"
    [ -z "$(share_mountpoint)" ] || exit 0
  done
  if [ "$_i" -ge "$REACH_TRIES" ]; then
    log "server ${SERVER}:445 unreachable; skipping"
    exit 0
  fi
  _n=1
  while [ "$_n" -le "$MOUNT_TRIES" ]; do
    _out=$(netfs_mount 2>&1) || true
    _mp=$(share_mountpoint)
    if [ -n "$_mp" ]; then
      ensure_link "$_mp"
      log "mounted ${_mp} (attempt ${_n})"
      exit 0
    fi
    log "attempt ${_n} failed: ${_out:-no error output}"
    _n=$((_n + 1))
    sleep "$MOUNT_WAIT"
  done
  log "gave up mounting ${VOLUME}"
  exit 1
}

cmd_uninstall() {
  bootout_agent || true
  if [ -f "$CONFIG_FILE" ]; then
    load_config
    cmd_unmount
    remove_soft
  fi
  rm -f "$PLIST_FILE" "$CONFIG_FILE" "$LOG_FILE" "$LOCK_FILE"
  rmdir "$(dirname "$CONFIG_FILE")" 2>/dev/null || true
  say "room removed. Delete this script to finish: $SELF"
}

main() {
  if [ $# -eq 0 ]; then
    if [ -f "$CONFIG_FILE" ]; then
      cmd_status
    else
      usage
    fi
    return 0
  fi
  _cmd=$1
  shift
  case $_cmd in
  add) cmd_add "$@" ;;
  status) cmd_status "$@" ;;
  doctor) cmd_doctor "$@" ;;
  logs | log) cmd_logs "$@" ;;
  mount) cmd_mount "$@" ;;
  unmount | umount) cmd_unmount "$@" ;;
  remove | rm) cmd_remove "$@" ;;
  agent) cmd_agent "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  version | --version | -V) say "room $VERSION" ;;
  help | --help | -h) usage ;;
  *) die "unknown command: $_cmd (try: room help)" ;;
  esac
}

main "$@"
