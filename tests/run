#!/bin/sh
# Focused tests for room's CLI and agent logic. Every system binary is stubbed,
# so the tests never touch the real launchd, network or filesystem mounts.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
room=$root/bin/room
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

export HOME="$tmp/home"
export ROOM_TEST_DIR="$tmp"
mkdir -p "$HOME" "$tmp/bin"

cat >"$tmp/bin/launchctl" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$ROOM_TEST_DIR/launchctl.log"
EOF
cat >"$tmp/bin/nc" <<'EOF'
#!/bin/sh
exit 0
EOF
# Finder's `mount volume` (-e) mounts at ROOM_TEST_MOUNT; the agent's NetFS call
# (-l JavaScript - URL DIR MODE) mounts exactly at DIR, or at DIR/Share.
cat >"$tmp/bin/osascript" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$ROOM_TEST_DIR/osascript.log"
if [ "$1" = -l ]; then
  cat >/dev/null
  if [ "$6" = exact ]; then mp=$5; else mp=$5/Share; fi
  printf '//user@server.local/Share on %s (smbfs, nodev)\n' "$mp" >"$ROOM_TEST_DIR/mounted"
else
  : >"$ROOM_TEST_DIR/mounted"
fi
EOF
cat >"$tmp/bin/mount" <<'EOF'
#!/bin/sh
[ -f "$ROOM_TEST_DIR/mounted" ] || exit 0
if [ -s "$ROOM_TEST_DIR/mounted" ]; then cat "$ROOM_TEST_DIR/mounted"; else printf '%s\n' "$ROOM_TEST_MOUNT"; fi
EOF
cat >"$tmp/bin/diskutil-busy" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$ROOM_TEST_DIR/diskutil.log"
exit 1
EOF
cat >"$tmp/bin/diskutil" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$ROOM_TEST_DIR/diskutil.log"
rm -f "$ROOM_TEST_DIR/mounted"
EOF
cat >"$tmp/bin/probe-ok" <<'EOF'
#!/bin/sh
exit 0
EOF
cat >"$tmp/bin/probe-hang" <<'EOF'
#!/bin/sh
sleep 30
EOF
cat >"$tmp/bin/probe-slow" <<'EOF'
#!/bin/sh
sleep 2
EOF
cat >"$tmp/bin/nc-down" <<'EOF'
#!/bin/sh
exit 1
EOF
cat >"$tmp/bin/security" <<'EOF'
#!/bin/sh
exit 0
EOF
chmod 755 "$tmp/bin/"*

export ROOM_MOUNT="$tmp/bin/mount"
export ROOM_NC="$tmp/bin/nc"
export ROOM_OSASCRIPT="$tmp/bin/osascript"
export ROOM_LAUNCHCTL="$tmp/bin/launchctl"
export ROOM_DISKUTIL="$tmp/bin/diskutil"
export ROOM_SECURITY="$tmp/bin/security"
export ROOM_PROBE="$tmp/bin/probe-ok"
export ROOM_HEALTH_WAIT=1
export ROOM_STALE_WAIT=3
export ROOM_TEST_MOUNT='//user@server.local/Share on /Volumes/Share (smbfs, nodev)'

fails=0
pass() { echo "ok   $1"; }
fail() {
  echo "FAIL $1" >&2
  fails=$((fails + 1))
}
assert_file() {
  if [ -f "$1" ]; then pass "$2"; else fail "$2 ($1 missing)"; fi
}
assert_contains() {
  if grep -q "$2" "$1"; then pass "$3"; else fail "$3 ($2 not in $1)"; fi
}

# add writes config + agent plist, loads the agent, and mounts.
"$room" add smb://user@server.local/Share >/dev/null
cfg=$HOME/.config/room/config
assert_file "$cfg" "add writes config"
assert_contains "$cfg" '^volume=/Volumes/Share$' "add records volume"
plist=$HOME/Library/LaunchAgents/room.plist
assert_file "$plist" "add writes agent plist"
assert_contains "$plist" '<string>room</string>' "plist label is room"
assert_contains "$tmp/launchctl.log" 'bootstrap gui/' "agent bootstrapped"

# add is idempotent, so it can be re-run from any device.
"$room" add smb://user@server.local/Share >/dev/null
assert_file "$cfg" "re-adding keeps the config"

# the share is linked at ~/room for a stable path.
if [ -L "$HOME/room" ]; then pass "room link created"; else fail "room link created"; fi

# status reports the mounted share.
if "$room" status | grep -q 'mounted'; then pass "status shows mounted"; else fail "status shows mounted"; fi

# doctor reports the setup.
if "$room" doctor | grep -q 'share:'; then pass "doctor reports"; else fail "doctor reports"; fi

# A password embedded in the URL is refused.
if "$room" add 'smb://user:secret@server.local/Share' >/dev/null 2>&1; then
  fail "reject embedded password"
else
  pass "reject embedded password"
fi

# The share is mounted soft, through one [SERVER:SHARE] section that is never duplicated.
nsmb=$HOME/Library/Preferences/nsmb.conf
"$room" mount >/dev/null
if [ "$(grep -cxF '[server.local:Share]' "$nsmb")" -eq 1 ] && grep -qx 'soft=yes' "$nsmb"; then
  pass "soft mount configured once"
else
  fail "soft mount configured once"
fi

# A share Finder mounted at /Volumes/Share-1 moves back to /Volumes/Share, without force
# and without Finder: the agent mounts through NetFS with no UI.
: >"$tmp/diskutil.log"
: >"$tmp/osascript.log"
ROOM_TEST_MOUNT='//user@server.local/Share on /Volumes/Share-1 (smbfs, nodev)' "$room" agent
if [ "$(readlink "$HOME/room")" = /Volumes/Share ] && grep -qx 'unmount /Volumes/Share-1' "$tmp/diskutil.log" &&
  ! grep -q force "$tmp/diskutil.log"; then
  pass "moved mount comes back"
else
  fail "moved mount comes back"
fi
if grep -q -- '-l JavaScript' "$tmp/osascript.log" && ! grep -q 'mount volume' "$tmp/osascript.log"; then
  pass "agent mounts with no UI"
else
  fail "agent mounts with no UI"
fi

# A Share-1 mount that something holds open is followed rather than unmounted.
printf '%s\n' '//user@server.local/Share on /Volumes/Share-1 (smbfs, nodev)' >"$tmp/mounted"
: >"$tmp/osascript.log"
ROOM_DISKUTIL="$tmp/bin/diskutil-busy" "$room" agent
if [ "$(readlink "$HOME/room")" = /Volumes/Share-1 ] && [ ! -s "$tmp/osascript.log" ]; then
  pass "busy moved mount followed"
else
  fail "busy moved mount followed"
fi
printf '%s\n' '//user@server.local/Share on /Volumes/Share (smbfs, nodev)' >"$tmp/mounted"

# A slow but live mount is kept: replacing it would break open files.
: >"$tmp/diskutil.log"
ROOM_PROBE="$tmp/bin/probe-slow" "$room" agent
if [ -s "$tmp/diskutil.log" ]; then fail "slow mount kept"; else pass "slow mount kept"; fi

# While the server is unreachable, a silent mount is left alone; a remount could not work.
ROOM_PROBE="$tmp/bin/probe-hang" ROOM_NC="$tmp/bin/nc-down" "$room" agent
if [ -s "$tmp/diskutil.log" ]; then fail "mount kept while server down"; else pass "mount kept while server down"; fi

# A listed mount that no longer answers is unmounted and mounted again.
: >"$tmp/diskutil.log"
ROOM_PROBE="$tmp/bin/probe-hang" "$room" agent
if grep -q '^unmount' "$tmp/diskutil.log" && [ -f "$tmp/mounted" ] && grep -q 'not responding' "$HOME/Library/Logs/room.log"; then
  pass "dead mount replaced"
else
  fail "dead mount replaced"
fi

# A lock left by a killed pass expires instead of stopping the agent for good.
lock=$HOME/Library/Logs/.room.lock
mkdir "$lock" && touch -t 202001010000 "$lock"
"$room" agent
if [ -d "$lock" ]; then fail "stale lock expires"; else pass "stale lock expires"; fi

# A leftover mount point at the volume path is mounted onto, so Finder never picks a -1 name.
left=$tmp/Volumes/Share
mkdir -p "$left" && chmod 111 "$left"
sed -i.bak "s|^volume=.*|volume=$left|" "$cfg"
rm -f "$tmp/mounted"
: >"$tmp/osascript.log"
"$room" agent
if grep -q -- "$left exact\$" "$tmp/osascript.log" && [ -w "$left" ]; then pass "leftover mount point reused"; else fail "leftover mount point reused"; fi
mv "$cfg.bak" "$cfg"

# remove unloads the agent and deletes the files.
"$room" remove >/dev/null
if [ -f "$cfg" ]; then fail "remove deletes config"; else pass "remove deletes config"; fi
if [ -f "$nsmb" ] && grep -qxF '[server.local:Share]' "$nsmb"; then fail "remove drops the soft section"; else pass "remove drops the soft section"; fi
if grep -q 'bootout gui/' "$tmp/launchctl.log"; then pass "agent booted out"; else fail "agent booted out"; fi

[ "$fails" -eq 0 ] || {
  echo "$fails test(s) failed"
  exit 1
}
echo "all tests passed"
