#!/bin/sh
# Focused tests for room's CLI and agent logic. Every system binary is stubbed,
# so the tests never touch the real launchd, network or filesystem mounts.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
room=$root/bin/room
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

export HOME="$tmp/home"
export ROOM_TEST_DIR="$tmp"
mkdir -p "$HOME" "$tmp/bin"

cat >"$tmp/bin/launchctl" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$ROOM_TEST_DIR/launchctl.log"
EOF
cat >"$tmp/bin/nc" <<'EOF'
#!/bin/sh
exit 0
EOF
cat >"$tmp/bin/osascript" <<'EOF'
#!/bin/sh
: >"$ROOM_TEST_DIR/mounted"
EOF
cat >"$tmp/bin/mount" <<'EOF'
#!/bin/sh
[ -f "$ROOM_TEST_DIR/mounted" ] && printf '%s\n' "$ROOM_TEST_MOUNT"
EOF
cat >"$tmp/bin/diskutil" <<'EOF'
#!/bin/sh
rm -f "$ROOM_TEST_DIR/mounted"
EOF
cat >"$tmp/bin/security" <<'EOF'
#!/bin/sh
exit 0
EOF
chmod 755 "$tmp/bin/"*

export ROOM_MOUNT="$tmp/bin/mount"
export ROOM_NC="$tmp/bin/nc"
export ROOM_OSASCRIPT="$tmp/bin/osascript"
export ROOM_LAUNCHCTL="$tmp/bin/launchctl"
export ROOM_DISKUTIL="$tmp/bin/diskutil"
export ROOM_SECURITY="$tmp/bin/security"
export ROOM_TEST_MOUNT='//user@server.local/Share on /Volumes/Share (smbfs, nodev)'

fails=0
pass() { echo "ok   $1"; }
fail() {
  echo "FAIL $1" >&2
  fails=$((fails + 1))
}
assert_file() {
  if [ -f "$1" ]; then pass "$2"; else fail "$2 ($1 missing)"; fi
}
assert_contains() {
  if grep -q "$2" "$1"; then pass "$3"; else fail "$3 ($2 not in $1)"; fi
}

# add writes config + agent plist, loads the agent, and mounts.
"$room" add smb://user@server.local/Share >/dev/null
cfg=$HOME/.config/room/config
assert_file "$cfg" "add writes config"
assert_contains "$cfg" '^volume=/Volumes/Share$' "add records volume"
plist=$HOME/Library/LaunchAgents/room.plist
assert_file "$plist" "add writes agent plist"
assert_contains "$plist" '<string>room</string>' "plist label is room"
assert_contains "$tmp/launchctl.log" 'bootstrap gui/' "agent bootstrapped"

# add is idempotent, so it can be re-run from any device.
"$room" add smb://user@server.local/Share >/dev/null
assert_file "$cfg" "re-adding keeps the config"

# the share is linked at ~/room for a stable path.
if [ -L "$HOME/room" ]; then pass "room link created"; else fail "room link created"; fi

# status reports the mounted share.
if "$room" status | grep -q 'mounted'; then pass "status shows mounted"; else fail "status shows mounted"; fi

# doctor reports the setup.
if "$room" doctor | grep -q 'share:'; then pass "doctor reports"; else fail "doctor reports"; fi

# A password embedded in the URL is refused.
if "$room" add 'smb://user:secret@server.local/Share' >/dev/null 2>&1; then
  fail "reject embedded password"
else
  pass "reject embedded password"
fi

# remove unloads the agent and deletes the files.
"$room" remove >/dev/null
if [ -f "$cfg" ]; then fail "remove deletes config"; else pass "remove deletes config"; fi
if grep -q 'bootout gui/' "$tmp/launchctl.log"; then pass "agent booted out"; else fail "agent booted out"; fi

[ "$fails" -eq 0 ] || {
  echo "$fails test(s) failed"
  exit 1
}
echo "all tests passed"
